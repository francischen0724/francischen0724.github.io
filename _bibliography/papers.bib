@article{chen2026radoncgym,
  abbr        = {Under Review},
  title       = {{RadOncGym}: An Agent-Based Framework for Radiotherapy Dose-Mimicking Optimization},
  author      = {Chen, Xiwen and others},
  journal     = {Manuscript under review, WACV 2027},
  year        = {2026},
  selected    = {true},
  website     = {/projects/radonc-gym/},
  abstract    = {RadOncGym is an agent environment for radiotherapy dose-mimicking optimization. Agents tune 12 planning-objective weights, use rapid surrogate feedback, and selectively request full Gurobi solves under a fixed budget. The evaluation spans 60 patients and 10 dose predictions per patient, yielding 600 contexts, and compares agent memory and role structures with numerical optimization methods.}
}

@article{chen2026tavo,
  abbr        = {Under Review},
  title       = {{TAVO}: Target-Aware Source Curation for Budgeted Cross-Center Tumor Segmentation},
  author      = {Chen, Xiwen and Liu, Ruishan},
  journal     = {Manuscript under review},
  year        = {2026},
  selected    = {true},
  bibtex_show = {true},
  website     = {/projects/tavo/},
  abstract    = {Target-Aware Valuation Optimization combines target similarity, gradient compatibility, source coverage, and diversity to select a budgeted set of external training cases. Rank normalization and validation-guided search adapt the combination to each target and budget, leaving the segmentation architecture, loss, and inference procedure unchanged. Evaluation covers eight held-out targets on BraTS 2021 and MAMA-MIA, with OfficeHome as a cross-task control.}
}

@article{chen2026tac,
  abbr        = {Under Review},
  title       = {Target-Anchored Coverage for Source--Target Curation in Cross-Center Medical Image Segmentation},
  author      = {Chen, Xiwen and Liu, Ruishan},
  journal     = {Manuscript under review, NeurIPS 2026},
  year        = {2026},
  selected    = {true},
  bibtex_show = {true},
  website     = {/projects/tac/},
  abstract    = {Target-Anchored Coverage couples active target-label acquisition with source-data curation for cross-center medical image segmentation. Queried target labels serve as reliability anchors for constructing compact, target-aligned source subsets under annotation constraints and distribution shift.}
}

